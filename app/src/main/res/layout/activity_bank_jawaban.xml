<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.daring.BankJawabanActivity">

    <!-- Judul & Filter -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tvJudul"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daftar Tugas"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/Green"
            android:layout_marginBottom="12dp" />

        <!-- Chip Group Matpel -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mata Pelajaran"
            android:textStyle="bold"
            android:textColor="#333"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupMatpel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:chipSpacing="8dp"
            android:layout_marginBottom="12dp" />

        <!-- Chip Group Kelas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kelas"
            android:textStyle="bold"
            android:textColor="#333"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupKelas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:chipSpacing="8dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnTampilkanData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tampilkan Data"
            android:layout_marginTop="16dp"/>
    </LinearLayout>

    <ProgressBar
        android:layout_marginTop="240dp"
        android:id="@+id/pb"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminateDrawable="@drawable/c_prog_bar"
        android:layout_centerInParent="true"/>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMateri"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="300dp"
        android:layout_marginBottom="72dp"
        android:clipToPadding="false"
        android:padding="16dp" />



</androidx.coordinatorlayout.widget.CoordinatorLayout>
